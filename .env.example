# Copy this file to ".env" and fill in your DEGIRO credentials.
# The .env file is gitignored — never commit real credentials.

DEGIRO_USERNAME=your_username
DEGIRO_PASSWORD=your_password

# 2FA handling:
#   * If your account uses an AUTHENTICATOR APP (TOTP), put the "setup key" secret here.
#   * If your account uses IN-APP APPROVAL (DEGIRO pushes a "tap Yes" prompt to your
#     phone), LEAVE THIS BLANK — sync will wait for you to approve in the app.
DEGIRO_TOTP_SECRET=

# Optional. If left blank, it is fetched automatically from your client details.
DEGIRO_INT_ACCOUNT=

# Path to the SQLite database (created on first sync).
DEGIRO_DB_PATH=data/degiro.db
